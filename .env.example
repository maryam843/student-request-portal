# Copy this file to .env and fill in your own values. Never commit .env.
# MongoDB server address. The database name (course_management) is set in persistence.js.
MONGODB_URI=mongodb://127.0.0.1:27017
SESSION_SECRET=change-me-to-a-long-random-string
PORT=8000
# Optional. Address used in the verification and reset links, e.g. https://portal.example.com
# (default: http://localhost:PORT)
BASE_URL=
# Set to production when the app runs behind HTTPS: the login cookie is then only sent over HTTPS
NODE_ENV=development
