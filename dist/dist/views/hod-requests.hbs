<style>
    :root {
        --primary-color: #62109d;
        --secondary-color: #4d0085;
        --hover-color: #5f1891;
        --light-bg: #dcccf4;
        font-family: 'Anton', sans-serif;
    }

    body {
        background-color: var(--light-bg);
        font-family: var(--font);
        padding: 10px;
        margin: 10px;
    }

    h1 {
        color: #f4f1fa;
        background-color: #9500ff;
        padding: 15px;
        text-align: center;
        font: 'Anton';
        border-radius: 12px;
    }


    h2,
    h3,
    h4 {
        color: white;
        background-color: #9500ff;
        padding: 12px 20px;
        border-radius: 10px;
        text-align: center;
        margin-bottom: 25px;
    }


    .filter-fields-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        justify-content: center;
        width: 100%;
        padding: 10px;

    }

    .filter-field {
        display: flex;
        flex-direction: column;
        width: 50%;
        /* Adjust the width to make them side by side */
        padding: 10px;
        background-color: #dcccf4;
        border-radius: 10px;

    }

    .filter-field label {
        font-weight: bold;
        color: var(--secondary-color);
        margin-bottom: 5px;
        font-size: 14px;
    }

    .filter-field select {
        padding: 10px;
        margin: 0 10px 10px 0;
        border-radius: 6px;
        border: 1px solid #999;
    }

    .filter-field label:hover {
        color: var(--hover-color);
    }

    .sub-heading {
        font-size: 24px;
        color: #ffffff;
        text-align: center;
        margin: 40px 0 15px;
        background-color: #8404df;
    }

    .filter-container {
        text-align: center;
        margin-bottom: 30px;
    }

    .filter-container select {
        padding: 10px;
        margin: 0 10px 10px 0;
        border-radius: 6px;
        border: 1px solid #999;
    }

    .filter-container button {
        background-color: var(--primary-color);
        color: white;
        padding: 10px 18px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .filter-container button:hover {
        background-color: var(--hover-color);
    }

    .btn-view {
        background-color: var(--primary-color);
        color: white;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
        margin-top: 10px;
        display: inline-block;
    }

    .btn-view:hover {
        background-color: var(--hover-color);
    }

    .requests-table {
        width: 100%;
        border-collapse: collapse;
        background-color: rgb(246, 240, 255);
        border-radius: 10px;
        overflow: hidden;
    }

    .requests-table th,
    .requests-table td {
        border: 1px solid #ccc;
        text-align: center;
    }

    .requests-table th {
        padding: 15px 12px;
        background-color: #62109d;
        font-weight: bold;
        color: #ffffff
    }
/* Styling for Cancelled Requests (Full row strikethrough) */
.requests-table .cancelled {
    font-weight: lighter; /* Lighter font for canceled requests */
    position: relative;
    opacity: 0.7; /* Reduced opacity */
    text-decoration: line-through; /* Strikethrough across the entire row */
    background-color: #f8d7da; /* Light red background for cancelled requests */
    color: #721c24; /* Darker text color for readability */
}

/* Optional: Styling for Pending Requests (if you want specific styling) */
.requests-table .pending {
    background-color: #e7ffe6;
    font-weight: bold;
    color: #5a009b;
}

/* Styling for Cancelled Requests (Strikethrough text only) */
.strikethrough {
    text-decoration: line-through;
    color: #721c24; /* Color for strikethrough text */
}


    .queue-summary-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-top: 40px;
    }

    .queue-card {
        background-color: white;
        padding: 20px;
        width: 220px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(80, 1, 135, 0.2);
        text-align: center;
    }

    .queue-category {
        font-size: 18px;
        font-weight: bold;
        color: var(--secondary-color);
    }

    .queue-count {
        font-size: 16px;
        color: #555;
        margin-bottom: 10px;
    }

    .random-request-container {
        margin: 50px auto;
        text-align: center;
    }

    .btn-random {
        background-color: var(--hover-color);
        color: white;
        padding: 15px 25px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        display: inline-block;
        font-size: 18px;
    }

    .btn-random:hover {
        background-color: #7645b1;
    }

    .action-section {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin: 40px auto;
        max-width: 1200px;
        padding: 0 20px;
        flex-wrap: nowrap;
        /* Prevent wrapping unless screen is too small */
    }

    .action-card {
        background-color: white;
        padding: 25px 20px;
        width: 100%;
        flex: 1;
        border-radius: 12px;
        box-shadow: 0 0 12px rgba(80, 1, 135, 0.15);
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }


    .action-card select,
    .action-card label,
    .action-card button {
        display: block;
        width: 100%;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .action-card select {
        padding: 8px;
        border-radius: 6px;
        border: 1px solid #999;
    }

    .action-card button {
        background-color: var(--primary-color);
        color: white;
        padding: 10px 15px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .action-card button:hover {
        background-color: var(--hover-color);
    }

    .filter-fields-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        justify-content: center;
        width: 100%;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
        width: 130px;

    }
</style>

<!-- MAIN HEADING -->
<h1>Manage My Student Requests</h2>

    <!-- 3. QUEUE SUMMARY -->
    <h2 class="sub-heading">Queue Time: Who's Waiting? ⏳</h2>
    <p style="text-align:center; color:#333; margin-top:-10px; font-style: italic;">Queues of requests sorted into
        categories — Let's see what's cooking!</p>
    <div class="queue-summary-container">
        {{#each queues}}
        <div class="queue-card">
            <p class="queue-category">{{this._id}}</p>
            <p class="queue-count">{{this.pending}} request(s) pending out of {{this.total}} request{{#unless (eq
                this.total 1)}}s{{/unless}}</p>
            <a href="/hod/queue/{{this._id}}" class="btn-view">View Queue</a>
        </div>
        {{/each}}
    </div>

    <!-- 1. ACTION CARDS (Filter / View All / Random) -->
    <h2 class="sub-heading">Manage Student Requests</h2>
    <div class="action-section">
        <!-- Filter Requests Card -->
        <div class="action-card">
            <h3>🔍 Filter Requests</h3>
            <p>Lets filter the requests based on
                Category or Semester or even both!</p>
            <form action="/hod-requests" method="GET" class="filter-form">
                <div class="filter-fields-row">
                    <div class="filter-field">
                        <label for="category">Category</label>
                        <select name="category" id="category">
                            <option value="">Select</option>
                            <option value="Course Advice">Course Advice</option>
                            <option value="Attendance">Attendance</option>
                            <option value="Registration">Registration</option>
                            <option value="Major Change">Major Change</option>
                        </select>
                    </div>

                    <div class="filter-field">
                        <label for="semester">Semester</label>
                        <select name="semester" id="semester">
                            <option value="">Select</option>
                            <option value="Fall 2023">Fall 2023</option>
                            <option value="Fall 2024">Fall 2024</option>
                            <option value="Fall 2025">Fall 2025</option>
                            <option value="Spring 2023">Spring 2023</option>
                            <option value="Spring 2024">Spring 2024</option>
                            <option value="Spring 2025">Spring 2025</option>
                            <option value="Winter 2023">Winter 2023</option>
                            <option value="Winter 2024">Winter 2024</option>
                            <option value="Winter 2025">Winter 2025</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn-random">Apply Filter</button>
            </form>


        </div>

        <!-- View All Requests Card -->
        <div class="action-card">
            <h3>📋 View All Requests</h3>
            <p>See the full list of student request details, where the
                request status and submission time is presented in detail!
            </p>
            <a href="/hod-requests" class="btn-random">View All</a>
        </div>

        <!-- Random Request Card -->
        <div class="action-card">
            <h3>🎲 Random Request</h3>
            <p>Not sure where to begin?
                Let us pick one for you!</p>
            <a href="/hod/random" class="btn-random">Pick One</a>
        </div>
    </div>

    <!-- 2. STUDENT REQUEST TABLE -->
    <h2 class="sub-heading">Student Request List</h2>
    <table class="requests-table">
        <thead>
            <tr>
                <th>Student</th>
                <th>Category</th>
                <th>Semester</th>
                <th>Status</th>
                <th>Submitted On</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each requests}}
            <tr class="{{#if (eq status "Cancelled")}}cancelled{{else if (eq status "Pending" )}}pending{{/if}}">
                <td>{{this.studentName}}</td>
                <td>{{this.category}}</td>
                <td>{{this.semester}}</td>
                <td>{{this.status}}</td>
                <td>{{formatDate this.timestamp}}</td>
                <td><a href="/hod/view/{{this._id}}" class="btn-view">View</a></td>
            </tr>
            {{else}}
            <tr>
                <td colspan="6">No requests found.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>