<!DOCTYPE html>
<html lang="en">

<head>
  <title>Submit Request</title>

  <!-- CoreUI Styles -->
  <link rel="stylesheet" href="vendors/simplebar/css/simplebar.css">
  <link rel="stylesheet" href="/css/vendors/simplebar.css">
  <link href="/css/style.css" rel="stylesheet">

  <style>
    :root {
      --primary-color: #0e6251;
      --secondary-color: #0b5345;
      --hover-color: #117a65;
      --light-bg: #d0ece7;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: var(--light-bg);
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 800px;
      margin: 60px auto;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      padding: 30px;
    }

    h1 {
      text-align: center;
      color: var(--primary-color);
    }

    label {
      font-weight: bold;
      color: #333;
    }

    input[type="text"],
    textarea,
    select {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      margin-bottom: 20px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    button {
      background-color: var(--primary-color);
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      width: 100%;
    }

    button:hover {
      background-color: var(--hover-color);
    }

    a {
      display: block;
      text-align: center;
      margin-top: 20px;
      color: var(--primary-color);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .status-table {
      width: 100%;
      margin-top: 40px;
      border-collapse: collapse;
    }

    .status-table th,
    .status-table td {
      padding: 10px;
      text-align: left;
      border: 1px solid #ddd;
    }

    .status-table th {
      background-color: var(--primary-color);
      color: white;
    }

    .status-table td {
      background-color: #f9f9f9;
    }

    .status-table tr:hover {
      background-color: var(--hover-color);
      color: white;
    }

    .status-table .completed {
      color: green;
    }

    .status-table .pending {
      color: orange;
    }

    .status-table .cancelled {
      color: red;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>Submit a New Request</h1>

    <form action="/student-request" method="POST">

      <label for="semester">Semester</label>
      <select id="semester" name="semester" required>
        <option value="">Select Semester</option>
        <option value="Fall 2023">Fall 2023</option>
        <option value="Fall 2024">Fall 2024</option>
        <option value="Fall 2025">Fall 2025</option>
        <option value="Spring 2023">Spring 2023</option>
        <option value="Spring 2024">Spring 2024</option>
        <option value="Spring 2025">Spring 2025</option>
        <option value="Winter 2023">Winter 2023</option>
        <option value="Winter 2024">Winter 2024</option>
        <option value="Winter 2025">Winter 2025</option>
      </select>

      <label for="category">Category</label>
      <select id="category" name="category" required>
        <option value="">Select a category</option>
        <option value="Course Advice" title="For guidance on course selection, prerequisites, and academic advice">
          Course Advice</option>
        <option value="Attendance" title="Requests for attendance-related issues">Attendance</option>
        <option value="Registration" title="Requests regarding course registration or changes">Registration</option>
        <option value="Major Change" title="For requests regarding a change in your academic major">Major Change
        </option>
      </select>

      <label for="description">Description:</label>
      <textarea id="description" name="description" required></textarea>

      <input type="hidden" name="email" value="{{email}}"> <!-- Add email here -->

      <button type="submit">Submit Request</button>
    </form>
    <a href="/student-dashboard?email={{email}}">Back to HomePage</a>
</body>

</html>