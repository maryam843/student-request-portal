<style>
  :root {
    --primary-color: #872fc5;
    --secondary-color: #500187;
    --hover-color: #5936a0;
    --light-bg: #cbbae5;
    font-family: 'Anton', sans-serif;

  }

  body {
    background-color: var(--light-bg);
    font-family: var(--font);
    padding:20px;
  }

  h1, h2 {
    color: white;
    background-color: var(--primary-color);
    padding: 10px 15px;
    border-radius: 10px;
    text-align: center;
    margin-bottom: 20px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: 60%;
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 0 10px rgba(80, 1, 135, 0.2);
  }

  li {
    margin: 10px 0;
    font-size: 18px;
    color: #333;
  }

  li a {
    margin-left: 10px;
    background-color: var(--secondary-color);
    color: white;
    padding: 6px 10px;
    text-decoration: none;
    border-radius: 6px;
  }

  li a:hover {
    background-color: var(--hover-color);
  }

  .request-form {
    background-color: white;
    padding: 25px;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: 0 0 10px rgba(80, 1, 135, 0.3);
    width: 60%;
  }

  .request-form label {
    display: block;
    font-weight: bold;
    margin-top: 10px;
    color: #333;
  }

  .request-form select,
  .request-form textarea {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  .request-form button {
    background-color: var(--primary-color);
    color: white;
    padding: 10px 18px;
    border: none;
    border-radius: 6px;
    margin-top: 15px;
    cursor: pointer;
    text-align: center;
  }

  .request-form button:hover {
    background-color: var(--hover-color);
  }
</style>

<!-- hod-request.hbs -->
<div class="request-form">
<h1>Request Details</h1>
<p><strong>Student:</strong> {{request.studentName}}</p>
<p><strong>Category:</strong> {{request.category}}</p>
<p><strong>Description:</strong> {{request.description}}</p>
<p><strong>Status:</strong> {{request.status}}</p>
<p><strong>Timestamp:</strong> {{request.timestamp}}</p>
<p><strong>Estimated Completion:</strong> {{request.estimatedCompletion}}</p>

<!-- Form for processing the request -->
<form action="/hod/request/{{request._id}}" method="POST">
    <label for="status">Change Status</label>
    <select name="status" id="status" required>
        <option value="approved">Approved</option>
        <option value="rejected">Rejected</option>
    </select>
    <label for="note">Note:</label>
    <textarea name="note" id="note" rows="4" placeholder="Optional note..."></textarea>
    <button type="submit">Process Request</button>
</form>

</div>

