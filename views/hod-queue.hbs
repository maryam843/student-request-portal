<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<style>
    :root {
        --primary-color: #62109d;
        --secondary-color: #4d0085;
        --hover-color: #5f1891;
        --light-bg: #dcccf4;
        font-family: 'Anton', sans-serif;
    }

    body {
        background-color: var(--light-bg);
        font-family: var(--font);
        padding: 10px;
        margin: 10px;
    }

    h1 {
        color: white;
        background-color: var(--primary-color);
        padding: 12px 20px;
        border-radius: 10px;
        text-align: center;
    }

    .requests-table {
        width: 100%;
        border-collapse: collapse;
        background-color: rgb(246, 240, 255);
        border-radius: 10px;
        overflow: hidden;
        margin-top: 20px;
    }

    .requests-table th,
    .requests-table td {
        border: 1px solid #ccc;
        text-align: center;
        padding: 12px 18px;
    }

    .requests-table th {
        background-color: var(--primary-color);
        color: white;
    }

    .requests-table .pending {
        background-color: #fff3e6;
        font-weight: bold;
        color: #3f006c;
    }

    .requests-table .cancelled {
        font-weight: lighter;
        position: relative;
    }

    .requests-table .cancelled td {
        position: relative;
        z-index: 0;
    }

    .requests-table .cancelled td::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: #be0a0a;
        z-index: 2;
        pointer-events: none;
    }

    .requests-table .cancelled td {
        opacity: 0.8;
    }

    p {
        color: var(--secondary-color);
        text-align: center;
        font-size: 25px;
        font-style: italic;
        font-weight: 600;
    }

    /* Styling the View Button */
    .view-btn {
        display: inline-block;
        padding: 8px 16px;
        font-size: 16px;
        color: white;
        background-color: #62109d; /* Purple button */
        border: none;
        border-radius: 5px;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

    .view-btn:hover {
        background-color: #5f1891; /* Lighter purple on hover */
        transform: scale(1.05); /* Slightly enlarge on hover */
    }

    .view-btn:active {
        background-color: #4d0085; /* Darker purple on active */
    }

    .view-btn:focus {
        outline: none;
    }
</style>

<!-- Display Requests in a Table -->
<h1>Request Queue - {{category}}</h1>
<p style="text-align:center;"><a href="/hod-requests" class="view-btn">Back to Student Requests</a> <a href="/admin-dashboard" class="view-btn">Back to Dashboard</a></p>

{{#if requests.length}}
<table class="requests-table">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        {{#each requests}}
        <tr>
            <td>{{this.studentName}}</td>
            <td>{{this.description}}</td>
            <td>
                <!-- View Button linking to request details page -->
                <a href="/hod/view/{{this._id}}" class="view-btn">View</a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>
{{else}}
<p>No requests in this category.</p>
{{/if}}
