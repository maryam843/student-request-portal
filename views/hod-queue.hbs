<p class="text-medium-emphasis">Pending requests in this category, oldest first.</p>
{{#if requests.length}}
<div class="card mb-4">
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>Submitted</th>
          <th>Student</th>
          <th>Description</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each requests}}
        <tr>
          <td>{{formatDate timestamp}}</td>
          <td class="text-nowrap">{{avatar studentPic "avatar-sm"}}{{studentName}}</td>
          <td>{{description}}</td>
          <td><a href="/hod/view/{{_id}}" class="btn btn-sm btn-primary">View</a></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<p>No pending requests in this category.</p>
{{/if}}
