<div class="card mb-4">
  <div class="card-body">
    <form action="/student-request" method="POST">
      <div class="mb-3">
        <label for="semester" class="form-label">Semester</label>
        <select id="semester" name="semester" class="form-select" required>
          <option value="">Select a semester</option>
          {{#each semesters}}
          <option value="{{this}}" {{#if (eq this ../form.semester)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>

      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select id="category" name="category" class="form-select" required>
          <option value="">Select a category</option>
          {{#each categories}}
          <option value="{{this}}" {{#if (eq this ../form.category)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <div class="form-text">Course Advice: course choice and prerequisites. Attendance: absences and late arrivals.
          Registration: adding, dropping or changing sections. Major Change: moving to another major.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="description" class="form-control" rows="5" required>{{form.description}}</textarea>
      </div>

      <button type="submit" class="btn btn-primary">Submit Request</button>
    </form>
  </div>
</div>
