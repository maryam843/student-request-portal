{{#if badgeCount}}
<div class="alert alert-info">
  You have {{badgeCount}} new update{{#unless (eq badgeCount 1)}}s{{/unless}} on your requests.
  <a href="/student-requests" class="alert-link">View updates</a>
</div>
{{else}}
<p class="text-medium-emphasis">No new updates.</p>
{{/if}}

<div class="row">
  <div class="col-sm-6 col-lg-4">
    <div class="card mb-4 text-white bg-primary">
      <div class="card-body">
        <div class="stat-number">{{requestCount}}</div>
        <div>My requests</div>
        <a href="/student-requests" class="text-white">View My Requests</a>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-4">
    <div class="card mb-4 text-white bg-warning">
      <div class="card-body">
        <div class="stat-number">{{pendingCount}}</div>
        <div>Pending</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-4">
    <div class="card mb-4">
      <div class="card-body">
        <div class="fw-semibold">Send a request to your Head of Department.</div>
        <a href="/student-request" class="btn btn-primary mt-2">New Request</a>
      </div>
    </div>
  </div>
</div>
