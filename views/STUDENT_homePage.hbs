<!DOCTYPE html>
<html lang="en">

<head>
  <base href="./">
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
  <meta name="description" content="Student Request Portal">
  <title>Student Dashboard</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="theme-color" content="#ffffff">
  <!-- Vendors styles-->
  <link rel="stylesheet" href="/vendors/simplebar/css/simplebar.css">
  <link rel="stylesheet" href="/css/vendors/simplebar.css">
  <!-- Main styles for this application-->
  <link href="/css/style.css" rel="stylesheet">
  <style>
    :root {
      --primary-color: #0e6251;
      --secondary-color: #0b5345;
      --hover-color: #117a65;
      --light-bg: #e6fffa;
    }

    .welcome-heading {
      color: #e6fffa;
      background-color: #0a5446;
      padding: 15px;
      text-align: center;
      font: 'Anton';
      border-radius: 12px;
    }

    html,
    body {
      height: 100%;
      margin: 0;
      padding: 5px;
      background-color: var(--light-bg);
    }

    .app,
    .wrapper,
    .content,
    .main,
    .container-fluid,
    .container {
      background-color: transparent !important;
    }

    #sidebar {
      background-color: #08493c !important;
      /* Dark Peacock Green */
      color: #ffffff;
    }
  </style>
</head>

<body>
  <div class="sidebar sidebar-dark sidebar-fixed" id="sidebar">
    <div class="sidebar-brand d-none d-md-flex">
      <span class="fs-5 fw-semibold">Student Portal</span>
    </div>
    <ul class="sidebar-nav" data-coreui="navigation" data-simplebar="">
      <li class="nav-item"><a class="nav-link" href="/student-dashboard">
          <svg class="nav-icon">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-speedometer"></use>
          </svg> Dashboard</a></li>
      <li class="nav-item"><a class="nav-link" href="/student-requests">
          <svg class="nav-icon">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-list-rich"></use>
          </svg> My Requests</a></li>
      <li class="nav-item"><a class="nav-link" href="/student-request">
          <svg class="nav-icon">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-pencil"></use>
          </svg> New Request</a></li>
      <li class="nav-item"><a class="nav-link" href="/profile">
          <svg class="nav-icon">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
          </svg> My Profile</a></li>
    </ul>
    <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable"></button>
  </div>
  <div class="wrapper d-flex flex-column min-vh-100 bg-light">
    <h1 class="welcome-heading">👋 Welcome {{user.username}}! This is your Student Home Page!</h1>
    {{#if badgeCount}}
    <p style="color: green; font-weight: bold; font-size: 1.2em;">
        🔔 You have {{badgeCount}} new update{{#unless (eq badgeCount 1)}}s{{/unless}} on your requests! 
        <a href="/student-requests">Click here!</a>
    </p>
{{else}}
    <p style="color: gray;">No new updates at the moment.</p>
{{/if}}
    <header class="header header-sticky mb-4">
      <div class="container-fluid">
        <button class="header-toggler px-md-0 me-md-3" type="button"
          onclick="coreui.Sidebar.getInstance(document.querySelector('#sidebar')).toggle()">
          <svg class="icon icon-lg">
            <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-menu"></use>
          </svg>
        </button><a class="header-brand d-md-none" href="/student-dashboard">Student Portal</a>
        <ul class="header-nav d-none d-md-flex">
          <li class="nav-item"  style="color: rgb(50, 152, 50); font-weight: bold;"><a class="nav-link" href="/student-requests">Requests</a></li>
          <li class="nav-item"><a class="nav-link" href="/student-request">Submit new Request</a></li>
        </ul>
        <ul class="header-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/student-requests" title="Updates on my requests">
              <svg class="icon icon-lg">
                <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-bell"></use>
              </svg>{{#if badgeCount}}<span class="badge badge-sm bg-danger ms-1">{{badgeCount}}</span>{{/if}}</a></li>
        </ul>
        <ul class="header-nav ms-3">
          <li class="nav-item dropdown"><a class="nav-link py-0" data-coreui-toggle="dropdown" href="#" role="button"
              aria-haspopup="true" aria-expanded="false">
              <div class="avatar avatar-md">
                {{#if profilePic}}
                <img class="avatar-img" src="/uploads/{{profilePic}}" alt="Profile picture">
                {{else}}
                <img class="avatar-img" src="/img/icons/profile.png" alt="No profile picture">
                {{/if}}
              </div>
            </a>
            <div class="dropdown-menu dropdown-menu-end pt-0">
              <div class="dropdown-header bg-light py-2">
                <div class="fw-semibold">Account</div>
              </div><a class="dropdown-item" href="/profile">
                <svg class="icon me-2">
                  <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                </svg> Profile</a>
              <div class="dropdown-divider"></div>
              <form action="/logout" method="POST">
                <button type="submit" class="dropdown-item">
                <svg class="icon me-2">
                  <use xlink:href="/vendors/@coreui/icons/svg/free.svg#cil-account-logout"></use>
                </svg> Logout</button>
              </form>
            </div>
          </li>
        </ul>
      </div>
      <div class="header-divider"></div>
      <div class="container-fluid">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb my-0 ms-2">
            <li class="breadcrumb-item">
              <!-- if breadcrumb is single--><span>Home</span>
            </li>
            <li class="breadcrumb-item active"><span>Dashboard</span></li>
          </ol>
        </nav>
      </div>
    </header>
    <div class="body flex-grow-1 px-3">
      <div class="container-lg">
        <div class="row">
          <div class="col-sm-6 col-lg-4">
            <div class="card mb-4 text-white bg-primary">
              <div class="card-body">
                <div class="fs-4 fw-semibold">{{requestCount}}</div>
                <div>My requests</div>
                <a href="/student-requests" class="text-white">See all my requests</a>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-lg-4">
            <div class="card mb-4 text-white bg-warning">
              <div class="card-body">
                <div class="fs-4 fw-semibold">{{pendingCount}}</div>
                <div>Pending</div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-lg-4">
            <div class="card mb-4">
              <div class="card-body">
                <div class="fs-5 fw-semibold">Need help from your department?</div>
                <a href="/student-request" class="btn btn-primary mt-2">Submit a new request</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Scripts -->
  <script src="/vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
  <script src="/vendors/simplebar/js/simplebar.min.js"></script>

</body>

</html>