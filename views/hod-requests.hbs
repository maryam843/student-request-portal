<h2 class="h5">Queues</h2>
<div class="row">
  {{#each queues}}
  <div class="col-sm-6 col-lg-3">
    <div class="card mb-4">
      <div class="card-body">
        <div class="fw-semibold">{{this._id}}</div>
        <div class="text-medium-emphasis mb-2">{{this.pending}} pending of {{this.total}}</div>
        <a href="/hod/queue/{{this._id}}" class="btn btn-sm btn-outline-primary">View Queue</a>
      </div>
    </div>
  </div>
  {{/each}}
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/hod-requests" method="GET" class="row g-3 align-items-end">
      <div class="col-sm-6 col-lg-3">
        <label for="category" class="form-label">Category</label>
        <select name="category" id="category" class="form-select">
          <option value="">All</option>
          {{#each categories}}
          <option value="{{this}}" {{#if (eq this ../filters.category)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-sm-6 col-lg-3">
        <label for="semester" class="form-label">Semester</label>
        <select name="semester" id="semester" class="form-select">
          <option value="">All</option>
          {{#each semesters}}
          <option value="{{this}}" {{#if (eq this ../filters.semester)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-sm-6 col-lg-3">
        <label for="status" class="form-label">Status</label>
        <select name="status" id="status" class="form-select">
          <option value="">All</option>
          {{#each statuses}}
          <option value="{{this}}" {{#if (eq this ../filters.status)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-sm-6 col-lg-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Apply Filter</button>
        <a href="/hod-requests" class="btn btn-outline-secondary">Clear</a>
      </div>
    </form>
    <a href="/hod/random" class="btn btn-outline-primary mt-3">Open a Random Pending Request</a>
  </div>
</div>

<h2 class="h5">Student Requests</h2>
<p class="text-medium-emphasis">{{requests.length}} request{{#unless (eq requests.length 1)}}s{{/unless}}, newest first.</p>
<div class="card mb-4">
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>Submitted</th>
          <th>Student</th>
          <th>Category</th>
          <th>Semester</th>
          <th>Description</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each requests}}
        <tr class="{{#if (eq status "Cancelled")}}row-cancelled{{/if}}">
          <td>{{formatDate timestamp}}</td>
          <td class="text-nowrap">{{avatar studentPic "avatar-sm"}}{{studentName}}</td>
          <td>{{category}}</td>
          <td>{{semester}}</td>
          <td>{{description}}</td>
          <td><span class="badge {{statusClass status}}">{{status}}</span></td>
          <td><a href="/hod/view/{{_id}}" class="btn btn-sm btn-primary">View</a></td>
        </tr>
        {{else}}
        <tr>
          <td colspan="7">No requests found.</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
