<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Request Details</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="/css/style.css" rel="stylesheet">
</head>

<body class="bg-light">
  <div class="container py-4">
    <div class="card p-4">
      <h1>📄 Request Details</h1>

      <p><strong>Semester:</strong> {{request.semester}}</p>
      <p><strong>Category:</strong> {{request.category}}</p>
      <p><strong>Status:</strong> {{request.status}}</p>
      <p><strong>Description:</strong> {{request.description}}</p>
      <p><strong>Submitted:</strong> {{formatDate request.timestamp}}</p>
      <p><strong>Note from HoD:</strong> {{#if request.note}}{{request.note}}{{else}}—{{/if}}</p>

      <div>
        <a href="/student-requests" style="color: green;">⬅️ Back to My Requests</a> |
        <a href="/student-dashboard" style="color: green;">Back to Home</a>
      </div>
    </div>
  </div>
</body>

</html>
