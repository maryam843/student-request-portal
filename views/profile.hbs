<div class="row">
  <div class="col-lg-6">
    <div class="card mb-4">
      <div class="card-body p-4">
        <div class="text-center mb-3">
          {{avatar currentUser.profilePic "rounded-circle profile-photo" 120}}
          <h2 class="h4 mt-2">{{currentUser.username}}</h2>
          <p class="text-medium-emphasis">{{currentUser.email}}</p>
        </div>

        <ul class="list-group mb-4">
          <li class="list-group-item">
            <strong>College:</strong> {{#if currentUser.college}}{{currentUser.college}}{{else}}Not set{{/if}}
          </li>
        </ul>

        <form action="/upload-profile" method="POST" enctype="multipart/form-data">
          <label for="profilePic" class="form-label">Change profile picture (JPG, PNG, GIF or WEBP, max 2 MB)</label>
          <input class="form-control mb-3" type="file" id="profilePic" name="profilePic"
            accept="image/jpeg,image/png,image/gif,image/webp" required>
          <button class="btn btn-primary" type="submit">Upload Picture</button>
        </form>
      </div>
    </div>
  </div>
</div>
