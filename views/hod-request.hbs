<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex align-items-center mb-3">
      {{avatar studentPic "rounded-circle profile-photo me-3" 48}}
      <div>
        <div class="fw-semibold">{{request.studentName}}</div>
        <div class="text-medium-emphasis">{{request.studentEmail}}</div>
      </div>
    </div>
    <dl class="details">
      <dt>Semester</dt>
      <dd>{{request.semester}}</dd>
      <dt>Category</dt>
      <dd>{{request.category}}</dd>
      <dt>Status</dt>
      <dd><span class="badge {{statusClass request.status}}">{{request.status}}</span></dd>
      <dt>Description</dt>
      <dd class="description">{{request.description}}</dd>
      <dt>Submitted</dt>
      <dd>{{formatDate request.timestamp}}</dd>
      {{#if (eq request.status "Pending")}}
      <dt>Estimated completion</dt>
      <dd>{{formatDate request.estimatedCompletion}}</dd>
      {{else}}
      <dt>Note from HoD</dt>
      <dd>{{#if request.note}}{{request.note}}{{else}}No note.{{/if}}</dd>
      {{/if}}
    </dl>

    {{#if (eq request.status "Pending")}}
    <form action="/hod/request/{{request._id}}" method="POST">
      <div class="mb-3">
        <label for="status" class="form-label">Decision</label>
        <select name="status" id="status" class="form-select" required>
          <option value="">Select a decision</option>
          <option value="Approved">Approved</option>
          <option value="Rejected">Rejected</option>
        </select>
      </div>
      <div class="mb-3">
        <label for="note" class="form-label">Note to the student (optional)</label>
        <textarea name="note" id="note" class="form-control" rows="4"></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Process Request</button>
    </form>
    {{else}}
    <p class="mb-0 text-medium-emphasis">This request is {{request.status}} and cannot be changed.</p>
    {{/if}}
  </div>
</div>
