{{#if requests.length}}
<div class="card mb-4">
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>Submitted</th>
          <th>Semester</th>
          <th>Category</th>
          <th>Description</th>
          <th>Status</th>
          <th>Estimated completion</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each requests}}
        <tr class="{{#if (eq status "Cancelled")}}row-cancelled{{/if}}">
          <td>{{formatDate timestamp}}</td>
          <td>{{semester}}</td>
          <td>{{category}}</td>
          <td>{{description}}</td>
          <td><span class="badge {{statusClass status}}">{{status}}</span></td>
          <td>{{#if (eq status "Pending")}}{{formatDate estimatedCompletion}}{{else}}Not applicable{{/if}}</td>
          <td>
            <div class="d-flex flex-wrap align-items-center gap-2">
              <a href="/student/request/{{_id}}" class="btn btn-sm btn-primary">View</a>
              {{#if (eq studentNotified false)}}<span class="badge bg-danger">New update</span>{{/if}}
              {{#if (eq status "Pending")}}
              <form action="/student-cancel/{{_id}}" method="POST">
                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
              </form>
              {{/if}}
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<p>You have not sent any requests yet.</p>
<a href="/student-request" class="btn btn-primary">New Request</a>
{{/if}}
